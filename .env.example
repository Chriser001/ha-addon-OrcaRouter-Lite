# ── Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Database (SQLite by default; Postgres opt-in) ─────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/orca

# ── Redis (optional — improves throughput) ────────────
# REDIS_URL=redis://localhost:6379/0

# ── Encryption (auto-generated on first run if empty) ──
# Once generated, set these explicitly so DB-stored provider
# keys remain decryptable across restarts.
# CREDENTIAL_ENCRYPTION_KEY=    # 64 hex chars (32 bytes)
# API_KEY_PEPPER=               # 32+ char string

# ── Provider keys (BYOK) ──────────────────────────────
# Set the provider keys you want to route through. Either
# put them here, or add them via the web UI (encrypted at rest).
# Env vars are convenient for ephemeral environments; UI-set
# keys take precedence when both are configured.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=

# ── Hosted-as-upstream (managed safety net) ───────────
# When set, OrcaRouter Lite uses your hosted orcarouter.ai
# account as one more provider. Useful for: try-before-you-buy,
# falling back when local providers fail, or running zero-config
# with everything routed through hosted.
# ORCAROUTER_API_KEY=sk-orca-...
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
